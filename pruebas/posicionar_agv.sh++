
#!/usr/bin/env bash
set -eo pipefail

ESTACION="${1:-3}"

case "$ESTACION" in
  1) Y="-1.4" ;;
  2) Y="-0.7" ;;
  3) Y="0.0" ;;
  4) Y="0.7" ;;
  5) Y="1.4" ;;
  *)
    echo "Uso: $0 [1|2|3|4|5]"
    exit 1
    ;;
esac

TOPICO="/gazebo/planta_bombeo_agv/model/modify"

echo "Estacion: $ESTACION"
echo "Posicion objetivo: X=0.9015 Y=$Y"
echo "Comprobando el transporte de Gazebo..."

gz topic -i -t "$TOPICO"

echo
echo "Antes de publicar, se debe confirmar"
echo "la altura Z actual del robot."
